#cloud-config

users:
  - default

  - name: ${ssh_user}
    gecos: Ansible Automation User
    shell: /bin/bash
    groups:
      - sudo
    sudo:
      - ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false

package_update: true

packages:
  - python3
  - python3-apt

runcmd:
  - echo "Legacy Tomcat Lab ready" > /etc/legacy-tomcat-lab